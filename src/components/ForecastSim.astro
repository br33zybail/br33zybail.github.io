---
// A small working copy of the forecast method, on invented numbers.
---

<section class="sim" data-sim aria-labelledby="sim-title">
  <div class="sim-head">
    <h2 id="sim-title">Try the method</h2>
    <p>
      This runs in your browser on invented deals. Each run moves every deal up the ladder with a drawn win chance and
      drawn waiting times, then adds the deals not yet created. The band is where 80% of 2,000 runs landed.
    </p>
  </div>

  <div class="sim-body">
    <form>
      <label>
        <span>Win chance from the first stage <output data-out="win"></output></span>
        <input type="range" name="win" min="5" max="40" step="1" value="20" />
      </label>
      <label>
        <span>Pace: time spent in each stage <output data-out="pace"></output></span>
        <input type="range" name="pace" min="60" max="160" step="5" value="100" />
      </label>
      <label>
        <span>New deals created each month <output data-out="create"></output></span>
        <input type="range" name="create" min="0" max="30" step="1" value="12" />
      </label>
      <label>
        <span>Deals already open <output data-out="open"></output></span>
        <input type="range" name="open" min="10" max="120" step="5" value="60" />
      </label>
      <p class="readout" aria-live="polite" data-readout></p>
    </form>

    <figure>
      <svg viewBox="0 0 640 360" role="img" aria-labelledby="sim-chart-title">
        <title id="sim-chart-title">Cumulative bookings over twelve months: median line with 50% and 80% bands</title>
        <g data-grid></g>
        <path data-band="80" />
        <path data-band="50" />
        <path data-median />
        <g data-axis></g>
      </svg>
      <figcaption>
        <span class="key k80"></span> 80% of runs <span class="key k50"></span> 50% of runs
        <span class="key kmed"></span> median. Units are invented.
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // Seeded generator so the same sliders always draw the same picture.
  const mulberry = (seed: number) => () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  const STAGES = 5;
  const MONTHS = 12;
  const RUNS = 2000;
  // Share of deals reaching each stage that go on to the next one, before scaling to the chosen win chance.
  const BASE_PASS = [0.55, 0.6, 0.7, 0.8, 0.85];
  // Mean days in each stage and how often a deal occupies it at all.
  const DWELL = [25, 40, 55, 30, 20];
  const OCCUPY = [0.65, 0.95, 0.9, 0.75, 0.95];

  function simulate(win: number, pace: number, create: number, open: number) {
    const rnd = mulberry(42);
    const normal = () => Math.sqrt(-2 * Math.log(1 - rnd())) * Math.cos(2 * Math.PI * rnd());
    // Marsaglia and Tsang gamma sampler.
    const gamma = (k: number): number => {
      if (k < 1) return gamma(k + 1) * Math.pow(rnd(), 1 / k);
      const d = k - 1 / 3;
      const c = 1 / Math.sqrt(9 * d);
      for (;;) {
        const x = normal();
        const v = (1 + c * x) ** 3;
        if (v > 0 && Math.log(rnd()) < 0.5 * x * x + d - d * v + d * Math.log(v)) return d * v;
      }
    };
    const beta = (a: number, b: number) => {
      const x = gamma(a);
      return x / (x + gamma(b));
    };
    const poisson = (mean: number) => {
      const limit = Math.exp(-mean);
      let k = 0;
      for (let p = rnd(); p > limit; p *= rnd()) k++;
      return k;
    };

    // Scale the ladder so the chance of winning from stage one equals the slider.
    const baseWin = BASE_PASS.reduce((a, b) => a * b, 1);
    const lift = Math.pow(win / baseWin, 1 / STAGES);
    const pass = BASE_PASS.map((p) => Math.min(0.97, p * lift));
    const winFrom = pass.map((_, s) => pass.slice(s).reduce((a, b) => a * b, 1));

    // The open book is fixed across runs: stage, days already in stage, size.
    const book = Array.from({ length: open }, () => ({
      stage: Math.floor(Math.pow(rnd(), 1.7) * STAGES),
      waited: rnd() * 12,
      size: Math.exp(3.4 + 0.7 * normal()),
    }));

    const totals: number[][] = Array.from({ length: MONTHS }, () => []);
    for (let run = 0; run < RUNS; run++) {
      // Each run draws its own win chance per stage, so the band carries the doubt in the rates.
      const p = winFrom.map((w) => beta(w * 60 + 0.5, (1 - w) * 60 + 0.5));
      const dwell = (s: number) => gamma(2.2) * (DWELL[s] / 2.2) * pace;
      const walk = (from: number) => {
        let days = 0;
        for (let s = from; s < STAGES; s++) if (rnd() < OCCUPY[s]) days += dwell(s);
        return days;
      };
      const months = new Array(MONTHS).fill(0);
      const book_ = (day: number, size: number) => {
        const m = Math.floor(day / 30.4);
        if (m < MONTHS) months[m] += size;
      };
      for (const d of book) {
        if (rnd() >= p[d.stage]) continue;
        book_(Math.max(0, dwell(d.stage) - d.waited) + walk(d.stage + 1), d.size);
      }
      for (let m = 0; m < MONTHS; m++) {
        const born = poisson(create * (0.6 + 0.8 * gamma(4) / 4));
        for (let i = 0; i < born; i++) {
          if (rnd() >= p[0]) continue;
          book_((m + rnd()) * 30.4 + walk(0), Math.exp(3.4 + 0.7 * normal()));
        }
      }
      let sum = 0;
      for (let m = 0; m < MONTHS; m++) totals[m].push((sum += months[m]));
    }
    return totals.map((runs) => {
      runs.sort((a, b) => a - b);
      const q = (f: number) => runs[Math.floor(f * (RUNS - 1))];
      return { p10: q(0.1), p25: q(0.25), p50: q(0.5), p75: q(0.75), p90: q(0.9) };
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-sim]')) {
    const form = root.querySelector('form')!;
    const svg = root.querySelector('svg')!;
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const W = 640, H = 360, L = 48, R = 12, T = 14, B = 34;

    const draw = () => {
      const v = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const win = +v.win / 100, pace = +v.pace / 100, create = +v.create, open = +v.open;
      root.querySelector('[data-out="win"]')!.textContent = `${v.win}%`;
      root.querySelector('[data-out="pace"]')!.textContent = pace === 1 ? 'default' : `${v.pace}% of default`;
      root.querySelector('[data-out="create"]')!.textContent = v.create;
      root.querySelector('[data-out="open"]')!.textContent = v.open;

      const q = simulate(win, pace, create, open);
      const top = Math.max(100, Math.ceil(q[MONTHS - 1].p90 / 100) * 100);
      const x = (m: number) => L + ((m + 1) / MONTHS) * (W - L - R);
      const y = (val: number) => H - B - (val / top) * (H - T - B);
      const line = (key: keyof (typeof q)[0]) => q.map((d, m) => `${x(m)},${y(d[key])}`);
      const band = (lo: keyof (typeof q)[0], hi: keyof (typeof q)[0]) =>
        `M${L},${y(0)} L${line(hi).join(' L')} L${line(lo).reverse().join(' L')} L${L},${y(0)} Z`;

      svg.querySelector('[data-band="80"]')!.setAttribute('d', band('p10', 'p90'));
      svg.querySelector('[data-band="50"]')!.setAttribute('d', band('p25', 'p75'));
      svg.querySelector('[data-median]')!.setAttribute('d', `M${L},${y(0)} L${line('p50').join(' L')}`);

      const ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => f * top);
      svg.querySelector('[data-grid]')!.innerHTML = ticks
        .map((t) => `<line x1="${L}" x2="${W - R}" y1="${y(t)}" y2="${y(t)}"/>`)
        .join('');
      svg.querySelector('[data-axis]')!.innerHTML =
        ticks.map((t) => `<text x="${L - 8}" y="${y(t) + 4}" text-anchor="end">${Math.round(t)}</text>`).join('') +
        [2, 5, 8, 11].map((m) => `<text x="${x(m)}" y="${H - 10}" text-anchor="${m === 11 ? 'end' : 'middle'}">month ${m + 1}</text>`).join('');

      const end = q[MONTHS - 1];
      readout.textContent = `After twelve months: median ${Math.round(end.p50)}, with 80% of runs between ${Math.round(end.p10)} and ${Math.round(end.p90)}.`;
    };

    form.addEventListener('input', draw);
    draw();
  }
</script>

<style>
  .sim {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--wash);
    border-radius: 14px;
  }
  .sim-head h2 {
    font-size: var(--step-2);
  }
  .sim-head p {
    margin-top: 0.6rem;
    max-width: 68ch;
    color: var(--ink-2);
  }
  .sim-body {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.5rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    align-items: start;
  }
  form {
    display: grid;
    gap: 1.1rem;
  }
  label {
    display: grid;
    gap: 0.35rem;
  }
  label span {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 550;
  }
  output {
    color: var(--cobalt);
    font-weight: 650;
    white-space: nowrap;
  }
  input[type='range'] {
    width: 100%;
    height: 1.75rem;
    accent-color: var(--cobalt);
  }
  .readout {
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-weight: 550;
    min-height: 3.4em;
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    background: var(--bg);
    border-radius: 10px;
  }
  svg :global(line) {
    stroke: var(--line);
  }
  svg :global(text) {
    font: 12px var(--font);
    fill: var(--ink-2);
  }
  [data-band='80'] {
    fill: var(--cobalt-tint);
  }
  [data-band='50'] {
    fill: color-mix(in oklch, var(--cobalt) 34%, white);
  }
  [data-median] {
    fill: none;
    stroke: var(--cobalt-deep);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  path {
    transition: d 220ms var(--ease);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .key {
    display: inline-block;
    width: 0.9rem;
    height: 0.6rem;
    margin: 0 0.25rem 0 0.6rem;
    border-radius: 2px;
    vertical-align: baseline;
  }
  .key:first-child {
    margin-left: 0;
  }
  .k80 {
    background: var(--cobalt-tint);
  }
  .k50 {
    background: color-mix(in oklch, var(--cobalt) 34%, white);
  }
  .kmed {
    height: 3px;
    background: var(--cobalt-deep);
    vertical-align: middle;
  }
</style>
